#: src/pam_pwquality.c:244
#, c-format
msgid "BAD PASSWORD: %s"
msgstr "NEPIEMĒROTA PAROLE: %s"

#: src/pwscore.c:22
#, c-format
msgid "Usage: %s [user]\n"
msgstr "Lietošana: %s [lietotājs]\n"

#: src/pwscore.c:23
#, c-format
msgid ""
"       The command reads the password to be scored from the standard input.\n"
msgstr "       Komanda nolasa vērtējamo paroli no standarta ievades.\n"

#: src/pwscore.c:53 src/pwscore.c:61 src/pwscore.c:67
#, c-format
msgid "Error: %s\n"
msgstr "Kļūda: %s\n"

#: src/pwscore.c:53
msgid "Could not obtain the password to be scored"
msgstr "Neizdevās iegūt vērtējamo paroli"

#: src/pwscore.c:75
#, c-format
msgid ""
"Password quality check failed:\n"
" %s\n"
msgstr ""
"Paroles kvalitātes pārbaude neizdevās:\n"
" %s\n"

#: src/pwmake.c:23
#, c-format
msgid "Usage: %s <entropy-bits>\n"
msgstr "Lietošana: %s <entropijas-biti>\n"

#: src/pwmake.c:58
#, c-format
msgid ""
"Warning: Value %ld is outside of the allowed entropy range, adjusting it.\n"
msgstr ""
"Brīdinājums: vērtība %ld ir ārpus atļautā entropijas diapazona, tā tiek "
"pielāgota.\n"

#: src/error.c:31
msgid "Memory allocation error when setting"
msgstr "Atmiņas piešķiršanas kļūda, iestatot vērtību"

#: src/error.c:35
msgid "Memory allocation error"
msgstr "Atmiņas piešķiršanas kļūda"

#: src/error.c:37
msgid "The password is the same as the old one"
msgstr "Parole ir tāda pati kā vecā"

#: src/error.c:39
msgid "The password is a palindrome"
msgstr "Parole ir palindroms"

#: src/error.c:41
msgid "The password differs with case changes only"
msgstr "Parole no vecās atšķiras tikai ar burtu reģistru"

#: src/error.c:43
msgid "The password is too similar to the old one"
msgstr "Parole ir pārāk līdzīga vecajai"

#: src/error.c:45
msgid "The password contains the user name in some form"
msgstr "Parole kādā veidā satur lietotājvārdu"

#: src/error.c:47
msgid "The password contains words from the real name of the user in some form"
msgstr "Parole kādā veidā satur vārdus no lietotāja īstā vārda"

#: src/error.c:49
msgid "The password contains forbidden words in some form"
msgstr "Parole kādā veidā satur aizliegtus vārdus"

#: src/error.c:52
#, c-format
msgid "The password contains less than %ld digits"
msgstr "Ciparu skaits parolē ir mazāks par %ld"

#: src/error.c:55
msgid "The password contains too few digits"
msgstr "Parolē ir pārāk maz ciparu"

#: src/error.c:58
#, c-format
msgid "The password contains less than %ld uppercase letters"
msgstr "Lielo burtu skaits parolē ir mazāks par %ld"

#: src/error.c:61
msgid "The password contains too few uppercase letters"
msgstr "Parolē ir pārāk maz lielo burtu"

#: src/error.c:64
#, c-format
msgid "The password contains less than %ld lowercase letters"
msgstr "Mazo burtu skaits parolē ir mazāks par %ld"

#: src/error.c:67
msgid "The password contains too few lowercase letters"
msgstr "Parolē ir pārāk maz mazo burtu"

#: src/error.c:70
#, c-format
msgid "The password contains less than %ld non-alphanumeric characters"
msgstr ""
"Speciālo rakstzīmju (ne burtu, ne ciparu) skaits parolē ir mazāks par %ld"

#: src/error.c:73
msgid "The password contains too few non-alphanumeric characters"
msgstr "Parolē ir pārāk maz speciālo rakstzīmju (ne burtu, ne ciparu)"

#: src/error.c:76
#, c-format
msgid "The password is shorter than %ld characters"
msgstr "Rakstzīmju skaits parolē ir mazāks par %ld"

#: src/error.c:79
msgid "The password is too short"
msgstr "Parole ir pārāk īsa"

#: src/error.c:81
msgid "The password is just rotated old one"
msgstr "Parole ir tā pati vecā parole ar cikliski nobīdītām rakstzīmēm"

#: src/error.c:84
#, c-format
msgid "The password contains less than %ld character classes"
msgstr "Rakstzīmju klašu skaits parolē ir mazāks par %ld"

#: src/error.c:87
msgid "The password does not contain enough character classes"
msgstr "Parolē nav pietiekami daudz rakstzīmju klašu"

#: src/error.c:90
#, c-format
msgid "The password contains more than %ld same characters consecutively"
msgstr "Vienādu secīgu rakstzīmju skaits parolē pārsniedz %ld"

#: src/error.c:93
msgid "The password contains too many same characters consecutively"
msgstr "Parolē ir pārāk daudz vienādu rakstzīmju pēc kārtas"

#: src/error.c:96
#, c-format
msgid ""
"The password contains more than %ld characters of the same class "
"consecutively"
msgstr "Vienas klases secīgu rakstzīmju skaits parolē pārsniedz %ld"

#: src/error.c:99
msgid ""
"The password contains too many characters of the same class consecutively"
msgstr "Parolē ir pārāk daudz vienas klases rakstzīmju pēc kārtas"

#: src/error.c:102
#, c-format
msgid "The password contains monotonic sequence longer than %ld characters"
msgstr "Parolē ir monotona rakstzīmju virkne, kuras garums pārsniedz %ld"

#: src/error.c:105
msgid "The password contains too long of a monotonic character sequence"
msgstr "Parolē ir pārāk gara monotona rakstzīmju virkne"

#: src/error.c:107
msgid "No password supplied"
msgstr "Parole nav norādīta"

#: src/error.c:109
msgid "Cannot obtain random numbers from the RNG device"
msgstr "Nevar iegūt nejaušus skaitļus no nejaušo skaitļu ģeneratora ierīces"

#: src/error.c:111
msgid "Password generation failed - required entropy too low for settings"
msgstr ""
"Paroles ģenerēšana neizdevās — pieprasītā entropija šiem iestatījumiem ir "
"pārāk zema"

#: src/error.c:114 src/error.c:117
msgid "The password fails the dictionary check"
msgstr "Parole neiztur vārdnīcas pārbaudi"

#: src/error.c:120 src/error.c:124
msgid "Unknown setting"
msgstr "Nezināms iestatījums"

#: src/error.c:127
msgid "Bad integer value of setting"
msgstr "Nederīga iestatījuma veselā skaitļa vērtība"

#: src/error.c:131
msgid "Bad integer value"
msgstr "Nederīga veselā skaitļa vērtība"

#: src/error.c:134
#, c-format
msgid "Setting %s is not of integer type"
msgstr "Iestatījums %s nav vesela skaitļa tipa"

#: src/error.c:138
msgid "Setting is not of integer type"
msgstr "Iestatījums nav vesela skaitļa tipa"

#: src/error.c:141
#, c-format
msgid "Setting %s is not of string type"
msgstr "Iestatījums %s nav virknes tipa"

#: src/error.c:145
msgid "Setting is not of string type"
msgstr "Iestatījums nav virknes tipa"

#: src/error.c:147
msgid "Opening the configuration file failed"
msgstr "Neizdevās atvērt konfigurācijas failu"

#: src/error.c:149
msgid "The configuration file is malformed"
msgstr "Konfigurācijas fails ir nepareizi veidots"

#: src/error.c:151
msgid "Fatal failure"
msgstr "Fatāla kļūme"

#: src/error.c:153
msgid "Unknown error"
msgstr "Nezināma kļūda"
