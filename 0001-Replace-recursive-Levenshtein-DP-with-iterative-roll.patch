From 30d0d0981457ddac7a7f76b98f28acd0a596eb1d Mon Sep 17 00:00:00 2001
From: litenglong <litenglong@kylinos.cn>
Date: Mon, 2 Nov 2026 10:58:43 +0800
Subject: [PATCH] Replace recursive Levenshtein DP with iterative rolling array

The Levenshtein distance computation in distcalculate() uses recursive
DP with depth up to max(m,n), and distance() allocates an (m+1)x(n+1)
int** matrix. For very long input strings, this can cause stack
overflow and excessive heap allocation.

Fix: rewrite distance() as an iterative Wagner-Fischer DP using two
rolling rows, indexed by the shorter string. This removes the
recursion entirely, keeps stack depth constant, and reduces memory
from O(m*n) to O(min(m,n)). The now-unused distdifferent() and
distcalculate() helpers are removed, and distance() keeps its
existing contract: it returns the exact edit distance on success and
-1 only on real allocation failure or when the input length exceeds
INT_MAX - 1.

Because the distance remains exact for all representable inputs and
the return contract is unchanged, no caller needs to be modified.
In particular, wordcheck() no longer silently skips the bad-word
check for long passwords, and similar() no longer reports a bogus
PWQ_ERROR_MEM_ALLOC for inputs that merely exceed an arbitrary
length threshold.

Signed-off-by: litenglong <litenglong@kylinos.cn>

Co-authored-by: Qwen-Coder <qwen-coder@alibabacloud.com>
---
 src/check.c | 175 +++++++++++++++++++++++++++++++---------------------
 1 file changed, 103 insertions(+), 72 deletions(-)

diff --git a/src/check.c b/src/check.c
index 088e83c..786be87 100644
--- a/src/check.c
+++ b/src/check.c
@@ -9,6 +9,7 @@
 #include <stdlib.h>
 #include <string.h>
 #include <ctype.h>
+#include <limits.h>   /* INT_MAX，用于长度上界检查 */
 #ifdef HAVE_CRACK_H
 #include <crack.h>
 #endif
@@ -44,93 +45,123 @@ palindrome(const char *new)
 }
 
 /*
- * Calculate how different two strings are in terms of the number of
- * character removals, additions, and changes needed to go from one to
- * the other
+ * 计算两个字符串的编辑距离（Levenshtein distance）。
+ *
+ * 迭代式 Wagner-Fischer DP + 两行滚动数组：
+ *   - 无递归，栈深度恒定，彻底消除原递归实现的栈溢出风险；
+ *   - 空间 O(min(m,n))，而非原实现的 O(m*n) 二维 int**；
+ *   - 对任意长度输入都返回精确距离，不破坏调用方语义。
  */
-
-static int
-distdifferent(const char *old, const char *new,
-              size_t i, size_t j)
-{
-        char c, d;
-
-        if ((i == 0) || (strlen(old) < i)) {
-                c = 0;
-        } else {
-                c = old[i - 1];
-        }
-
-        if ((j == 0) || (strlen(new) < j)) {
-                d = 0;
-        } else {
-                d = new[j - 1];
-        }
-        return (c != d);
-}
-
-static int
-distcalculate(int **distances, const char *old, const char *new,
-              size_t i, size_t j)
-{
-        int tmp = 0;
-
-        if (distances[i][j] != -1) {
-                return distances[i][j];
-        }
-
-        tmp = distcalculate(distances, old, new, i - 1, j - 1);
-        tmp = MIN(tmp, distcalculate(distances, old, new, i, j - 1));
-        tmp = MIN(tmp, distcalculate(distances, old, new, i - 1,     j));
-        tmp += distdifferent(old, new, i, j);
-
-        distances[i][j] = tmp;
-
-        return tmp;
-}
-
 static int
 distance(const char *old, const char *new)
 {
-        int **distances = NULL;
-        size_t m, n, i, j;
+        const char *s, *t;          /* s: 较长串, t: 较短串 */
+        int *prev = NULL;           /* 上一行 D[i-1][*] */
+        int *curr = NULL;           /* 当前行 D[i][*]   */
+        int *swaprow;
+        size_t m, n, i, j, tmp;
         int r = -1;
+        int cost, del, ins, sub;
 
         m = strlen(old);
         n = strlen(new);
-        distances = calloc(m + 1, sizeof(int*));
-        if (distances == NULL)
-                return -1;
 
-        for (i = 0; i <= m; i++) {
-                distances[i] = calloc(n + 1, sizeof(int));
-                if (distances[i] == NULL)
-                        goto allocfail;
+        /*
+         * 让 s 指向较长串、t 指向较短串。
+         * 滚动数组按 t 的长度 n 分配，因此取 n = min(m,n)。
+         * Levenshtein 距离对称，交换不影响结果。
+         */
+        if (m < n) {
+                s = new;
+                t = old;
+                tmp = m;
+                m = n;
+                n = tmp;
+        } else {
+                s = old;
+                t = new;
+        }
+
+        /*
+         * 距离上界为 max(m,n) = m。
+         * 递推中会出现 prev[j] + 1，最大为 m + 1，
+         * 必须保证 m + 1 <= INT_MAX，否则 int 溢出。
+         * 同时 curr[0] = (int)i 需要 i <= INT_MAX。
+         *
+         * 因此要求 m <= INT_MAX - 1。
+         * 实际密码场景不可达（2GB 字符串），但保持严格。
+         */
+        if (m > (size_t)(INT_MAX - 1))
+                return -1;
 
-                for(j = 0; j <= n; j++) {
-                        distances[i][j] = -1;
+        prev = malloc((n + 1) * sizeof(int));
+        curr = malloc((n + 1) * sizeof(int));
+        if (prev == NULL || curr == NULL)
+                goto out;           /* r 保持 -1，free(NULL) 安全 */
+
+        /*
+         * 边界：D[0][j] = j。
+         * prev 行初始对应 i = 0（s 的空前缀）。
+         * 此时 prev[j] = 把空串变成 t[0..j-1] 的插入次数 = j。
+         */
+        for (j = 0; j <= n; j++)
+                prev[j] = (int)j;
+
+        /*
+         * 主循环：逐行计算 D[i][*]。
+         * 每轮结束交换 prev/curr，使 prev 指向刚算完的行，
+         * curr 指向旧行（下一轮会被 curr[0] 和 curr[j] 完全覆盖）。
+         */
+        for (i = 1; i <= m; i++) {
+                /*
+                 * 边界：D[i][0] = i。
+                 * 即 s[0..i-1] 变成空串，只能删除 i 次。
+                 */
+                curr[0] = (int)i;
+
+                for (j = 1; j <= n; j++) {
+                        /*
+                         * cost = 0 表示 s[i-1] == t[j-1]，无需替换；
+                         * cost = 1 表示需要一次替换。
+                         */
+                        cost = (s[i - 1] != t[j - 1]);
+
+                        /*
+                         * 三个来源：
+                         *   del = D[i-1][j]   + 1  → 删除 s[i-1]（上方）
+                         *   ins = D[i][j-1]   + 1  → 插入 t[j-1]（左方，本轮已算）
+                         *   sub = D[i-1][j-1] + cost → 替换/匹配（左上）
+                         *
+                         * 注意 prev 是上一行，curr 是本行：
+                         *   prev[j]   = D[i-1][j]
+                         *   curr[j-1] = D[i][j-1]
+                         *   prev[j-1] = D[i-1][j-1]
+                         */
+                        del = prev[j] + 1;
+                        ins = curr[j - 1] + 1;
+                        sub = prev[j - 1] + cost;
+
+                        /* D[i][j] = min(del, ins, sub) */
+                        curr[j] = MIN(MIN(del, ins), sub);
                 }
-        }
-
-        for (i = 0; i <= m; i++) {
-                distances[i][0] = i;
-        }
 
-        for (j = 0; j <= n; j++) {
-                distances[0][j] = j;
+                /* 滚动：prev <- curr，curr <- 旧 prev（下一轮复用） */
+                swaprow = prev;
+                prev = curr;
+                curr = swaprow;
         }
 
-        r = distcalculate(distances, old, new, m, n);
-
-allocfail:
-        for (i = 0; i <= m; i++) {
-                if (distances[i]) {
-                        memset(distances[i], 0, sizeof(int) * (n + 1));
-                        free(distances[i]);
-                }
-        }
-        free(distances);
+        /*
+         * 循环结束后 prev 指向第 m 行，即 D[m][*]。
+         * D[m][n] 就是完整编辑距离。
+         * 若 m == 0（两串均为空或 n == 0），prev 仍是初始 row 0，
+         * prev[n] = n，恰好等于正确距离。
+         */
+        r = prev[n];
 
+out:
+        free(prev);
+        free(curr);
         return r;
 }
 
-- 
2.25.1

